# Database settings: the only place that names a checkout's database (placeholders only).
DB_HOST=127.0.0.1
# Host port of the shared postgres container (compose publishes it on 127.0.0.1 only).
DB_PORT=5432
DB_USER=app_dev
DB_PASSWORD=change-me
DB_DATABASE=app_dev
DB_TEST_DATABASE=app_test

# Host port of the Caddy dev proxy (127.0.0.1 only). Change it if port 80 is already taken.
PROXY_PORT=80
